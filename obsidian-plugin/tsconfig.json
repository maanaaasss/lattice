{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "noEmit": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["main.ts", "../src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
