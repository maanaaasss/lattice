{
  "name": "lattice",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node obsidian-plugin/esbuild.config.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gold:label": "tsx scripts/gold-label.ts",
    "eval": "tsx scripts/eval.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:direction": "tsx scripts/smoke-test.ts --direction-only",
    "smoke:causal": "tsx scripts/smoke-test.ts --causal-direction-only"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
